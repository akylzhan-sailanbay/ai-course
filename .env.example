# ─── Copy to .env and fill in. Never commit .env. ───────────────────────────────────────────

# Domain for Caddy (docker compose) and the public URL of the site.
DOMAIN=soberi.kz
PUBLIC_URL=https://soberi.kz
NODE_ENV=production
PORT=3000
# Behind Caddy/Nginx: 1. Directly exposed: leave empty.
TRUST_PROXY=1
# SQLite file. In Docker it lives on the app_data volume.
DATABASE_PATH=/data/app.db
# BACKUP_DIR=/data/backups

# ─── Telegram ───────────────────────────────────────────────────────────────────────────────
# @BotFather → /newbot. SECRET: anyone with this token controls the bot.
BOT_TOKEN=
# Optional: the bot username without @ (otherwise read from Telegram on start).
BOT_USERNAME=
# polling (simplest, default) or webhook (needs HTTPS PUBLIC_URL + secret below).
BOT_MODE=polling
# Required for webhook mode: 24+ random chars, e.g. `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=
# Team chat that receives new leads, payment requests and student questions.
# Add the bot to a group, send a message, read the chat id from /admin → or @RawDataBot. Group ids start with -100.
ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to press admin buttons and run /stats, /paid, /broadcast…
ADMIN_IDS=
# Private cohort group. Make the bot an admin with "Invite users" so it can create one-time invite links.
COHORT_CHAT_ID=
# Fallback if the bot can't create invites (shared link — less secure).
COHORT_INVITE_URL=
# Sent only to paid students, one hour before each session. SECRET-ish: never put it on the site.
ZOOM_URL=

# ─── Payments ───────────────────────────────────────────────────────────────────────────────
# Kaspi invoice-to-phone works with no config. Optional extras:
# A Kaspi Pay QR/payment link.
KASPI_PAY_URL=
# A card payment link from your provider. {lead} and {amount} are replaced per student.
PAYMENT_LINK_URL=

# ─── Web admin (/admin) ─────────────────────────────────────────────────────────────────────
# 12+ chars. Empty = /admin disabled. Login: any username + this password.
ADMIN_PASSWORD=

# ─── Analytics (all optional; these IDs are public by design) ───────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
YANDEX_METRICA_ID=
GA4_ID=
