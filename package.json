{
  "name": "soberi-s-ii",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page, application funnel, Telegram bot and analytics for the «Собери с ИИ» course",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0040 --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:placeholders": "tsx src/cli/placeholders.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
